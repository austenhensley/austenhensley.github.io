<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textGoalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_goal_weight_title"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textGoalHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="@string/enter_goal_weight_help"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/editGoalWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="@string/goal_weight_hint"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:autofillHints="" />

        <Button
            android:id="@+id/buttonSaveGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/save_goal" />

        <Button
            android:id="@+id/buttonCancelGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back_button_text" />

    </LinearLayout>
</ScrollView>